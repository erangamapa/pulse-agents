NODE_ENV=development
PORT=8080
LOG_LEVEL=info

BETTING_ENGINE_URL=https://api.oddsmith.dev/engine
TIMELINE_URL=https://api.oddsmith.dev/timeline
STATS_URL=https://api.oddsmith.dev/stats
ODDS_STREAM_URL=https://api.oddsmith.dev/odds/stream
SCORING_URL=http://scoring.sportsbook.internal:8000
TASKS_AUTH_TOKEN=<shared-secret-for-internal-routes>
ODDS_MAX_AGE_MS=10000
GCP_PROJECT_ID=oddsmith-dev

ANTHROPIC_API_KEY=<anthropic-api-key>
OPENAI_API_KEY=<openai-api-key>
VLLM_BASE_URL=http://vllm.sportsbook.internal:8000/v1

MAX_THREAD_REPLIES=2
THREAD_COOLDOWN_MS=60000
AGENT_HOP_BUDGET=3
PLACEMENT_RATE_PER_SECOND=50
COMMISSION_BPS=200
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_MS=15000

# Sidecar only
SCORING_MODEL_PATH=python/scoring/artifacts/win_model.joblib
